# Variables de ejemplo, sin secretos. En H0 no se usa base de datos.
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
WEB_PORT=5173
# Reservada para H1 (no usada en H0):
DATABASE_URL=postgresql://localhost:5432/pensia_docflow_dev
BETTER_AUTH_SECRET=<generar-con-openssl-rand-base64-32>
BETTER_AUTH_URL=http://127.0.0.1:3001
PENSIA_PLATFORM_ADMIN_EMAILS=<lista separada por comas>
WEB_TRUSTED_ORIGINS=<http://127.0.0.1:5173>
